{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "macnest",
  "version": "0.1.0",
  "identifier": "com.raninduamarasinghe.macnest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "macnest",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3RUFGNzMwNThERUE4M0YKUldRL3FONVlNUGZxTnpUeTBuQUI3UzR2QlR1VDhmang3ZGpFL3dTell6OXhveGN4ZGdLS0F0WTEK",
      "endpoints": [
        "https://github.com/RaninduAmarasinghe/MacNest/releases/latest/download/latest.json"
      ]
    }
  }
}
